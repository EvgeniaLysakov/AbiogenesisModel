<UserControl x:Class="AbiogenesisModel.App.Chart.ChartWrapper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AbiogenesisModel.App.Chart"
             xmlns:wpf="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance local:ChartWrapper}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
            FontWeight="SemiBold"
            Margin="0,0,0,12"/>

        <wpf:CartesianChart
            Grid.Row="1"
            Series="{Binding LiveChartAdapterViewModel.Series, RelativeSource={RelativeSource AncestorType=UserControl}}"
            XAxes="{Binding LiveChartAdapterViewModel.XAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
            YAxes="{Binding LiveChartAdapterViewModel.YAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
            LegendPosition="{Binding LegendPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"
            EasingFunction="{x:Null}" />
    </Grid>
</UserControl>
